{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>grigoriev/renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Node version of frontend-maven-plugin in pom.xml. It moves with .node-version.",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ],
      "matchStrings": [
        "<node\\.version>v(?<currentValue>[\\d.]+)</node\\.version>"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "The KoSIT XRechnung configuration in pom.xml. A new release also needs the file name and SHA-256 in the same pull request.",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) -->\\s*<xrechnung-config\\.version>(?<currentValue>[^<]+)</xrechnung-config\\.version>"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "The PostgreSQL image of the Testcontainers tests, below a renovate comment.",
      "managerFilePatterns": [
        "/^src/test/java/.+\\.java$/"
      ],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+static final String \\w+ = \"[^:]+:(?<currentValue>[^\"]+)\";"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Node of the CSS build: .node-version and pom.xml move together.",
      "matchDepNames": [
        "node"
      ],
      "groupName": "node"
    },
    {
      "description": "The Playwright package drives the browsers of the pinned image, so both move together. The screenshot tests guard the update.",
      "matchDepNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "playwright"
    }
  ]
}
