<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.grigoriev</groupId>
    <artifactId>im</artifactId>
    <version>0.1.2-SNAPSHOT</version>
    <name>im</name>
    <description>Invoice Manager: German e-invoices (ZUGFeRD, XRechnung) for a freelancer</description>
    <url>https://github.com/grigoriev/im</url>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <skipTests>false</skipTests>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mustang.version>2.26.0</mustang.version>
        <flying-saucer.version>10.7.0</flying-saucer.version>
        <kosit-validator.version>1.6.3</kosit-validator.version>
        <!-- renovate: datasource=github-releases depName=itplr-kosit/validator-configuration-xrechnung -->
        <xrechnung-config.version>v2026-08-31</xrechnung-config.version>
        <xrechnung-config.file>xrechnung-3.0.2-validator-configuration-2026-08-31.zip</xrechnung-config.file>
        <xrechnung-config.sha256>2530cd107c414511c5d0462ec10f886910395abfca820db82e83d70bf01221a8</xrechnung-config.sha256>
        <testcontainers.version>2.0.5</testcontainers.version>
        <greenmail.version>2.1.15</greenmail.version>
        <bouncycastle.version>1.87</bouncycastle.version>

        <jacoco.version>0.8.16</jacoco.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <frontend-plugin.version>2.0.2</frontend-plugin.version>
        <download-plugin.version>2.1.0</download-plugin.version>
        <sonar-plugin.version>5.8.0.7211</sonar-plugin.version>
        <!-- Keep equal to .node-version. -->
        <node.version>v26.13.1</node.version>

        <sonar.organization>grigoriev</sonar.organization>
        <sonar.projectKey>grigoriev_im</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco-merged/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.sources>src/main/java,src/main/resources,src/main/frontend,scripts,pom.xml,Dockerfile</sonar.sources>
        <sonar.tests>src/test/java,e2e/tests</sonar.tests>
        <sonar.exclusions>**/*.ttf,**/*.woff2</sonar.exclusions>
        <!-- Browser code and build scripts are covered by the Playwright E2E tests, not by JaCoCo. -->
        <sonar.coverage.exclusions>src/main/resources/static/**,src/main/frontend/**,scripts/**</sonar.coverage.exclusions>
        <!-- The migrations are PostgreSQL. The PL/SQL analyzer reads them as Oracle and asks for VARCHAR2. -->
        <sonar.plsql.file.suffixes>.plsql-not-used</sonar.plsql.file.suffixes>
        <sonar.issue.ignore.multicriteria>dockerdigest,mustangdate,securitythrows,backupsql,backupupload</sonar.issue.ignore.multicriteria>
        <!-- Base images carry tag and digest: the digest pins, the tag lets Renovate and humans read the version. -->
        <sonar.issue.ignore.multicriteria.dockerdigest.ruleKey>docker:S8431</sonar.issue.ignore.multicriteria.dockerdigest.ruleKey>
        <sonar.issue.ignore.multicriteria.dockerdigest.resourceKey>Dockerfile</sonar.issue.ignore.multicriteria.dockerdigest.resourceKey>
        <!-- The Mustang API takes java.util.Date. The mapper converts from java.time at this one boundary. -->
        <sonar.issue.ignore.multicriteria.mustangdate.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.mustangdate.ruleKey>
        <sonar.issue.ignore.multicriteria.mustangdate.resourceKey>**/MustangInvoiceMapper.java</sonar.issue.ignore.multicriteria.mustangdate.resourceKey>
        <!-- HttpSecurity.build() declares "throws Exception"; the bean method must pass it on. -->
        <sonar.issue.ignore.multicriteria.securitythrows.ruleKey>java:S112</sonar.issue.ignore.multicriteria.securitythrows.ruleKey>
        <sonar.issue.ignore.multicriteria.securitythrows.resourceKey>**/config/SecurityConfig.java</sonar.issue.ignore.multicriteria.securitythrows.resourceKey>
        <!-- The full export works on every table: the table names are constants, and a column name of an import reaches
             SQL only after a check against the table in pg_attribute and a name pattern. The values are parameters. -->
        <sonar.issue.ignore.multicriteria.backupsql.ruleKey>java:S2077</sonar.issue.ignore.multicriteria.backupsql.ruleKey>
        <sonar.issue.ignore.multicriteria.backupsql.resourceKey>**/backup/BackupService.java</sonar.issue.ignore.multicriteria.backupsql.resourceKey>
        <!-- The full export holds every document. Only the admin uploads it, and 128 MB fit years of invoices. -->
        <sonar.issue.ignore.multicriteria.backupupload.ruleKey>java:S5693</sonar.issue.ignore.multicriteria.backupupload.ruleKey>
        <sonar.issue.ignore.multicriteria.backupupload.resourceKey>**/application.properties</sonar.issue.ignore.multicriteria.backupupload.resourceKey>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Passkeys: Touch ID and Face ID through WebAuthn (docs/PLAN.md, section 5). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-webauthn</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <!-- Argon2 password hashes (docs/PLAN.md, section 5). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- E-invoice: ZUGFeRD and XRechnung generation and validation -->
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>library</artifactId>
            <version>${mustang.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>validator</artifactId>
            <version>${mustang.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>validator</artifactId>
            <version>${kosit-validator.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xhtmlrenderer</groupId>
            <artifactId>flying-saucer-pdf</artifactId>
            <version>${flying-saucer.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- A fixed name, so the Dockerfile needs no version. -->
        <finalName>im</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- CSS (Tailwind, daisyUI) and the browser libraries, built into target/classes/static. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-plugin.version}</version>
                <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <installDirectory>${project.build.directory}/node</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>ci --ignore-scripts --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Unit tests: *Test. Integration tests: *IT, run by failsafe in the verify phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- UTC as in the container: a time shown without the zone of Berlin fails. -->
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Duser.timezone=UTC</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Coverage: the unit tests must cover every line and branch (docs/PLAN.md, section 10).
              The integration tests add to the merged report that SonarCloud reads.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-unit</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-it</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-unit</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-unit</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- No tests, no coverage to check: "mvn package -DskipTests" builds the jar for the E2E run. -->
                            <skip>${skipTests}</skip>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>merge</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-merged</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Mutation tests of the domain core: tax rules, amounts, the mapping to EN 16931. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>io.github.grigoriev.im.einvoice.TaxCategory</param>
                        <param>io.github.grigoriev.im.einvoice.InvoiceFormat</param>
                        <param>io.github.grigoriev.im.einvoice.InvoiceLine</param>
                        <param>io.github.grigoriev.im.einvoice.InvoiceDocument</param>
                        <param>io.github.grigoriev.im.einvoice.MustangInvoiceMapper</param>
                        <param>io.github.grigoriev.im.seller.SellerService</param>
                        <param>io.github.grigoriev.im.seller.TaxNoteService</param>
                        <param>io.github.grigoriev.im.numbering.NumberPattern</param>
                        <param>io.github.grigoriev.im.numbering.NumberService</param>
                        <param>io.github.grigoriev.im.validation.Fields</param>
                        <param>io.github.grigoriev.im.customer.CustomerService</param>
                        <param>io.github.grigoriev.im.country.CountryService</param>
                        <param>io.github.grigoriev.im.audit.AuditService</param>
                        <param>io.github.grigoriev.im.invoice.InvoiceService</param>
                        <param>io.github.grigoriev.im.invoice.DraftForm</param>
                        <param>io.github.grigoriev.im.invoice.DraftLine</param>
                        <param>io.github.grigoriev.im.invoice.LineForm</param>
                        <param>io.github.grigoriev.im.invoice.TemplateService</param>
                        <param>io.github.grigoriev.im.invoice.Placeholders</param>
                        <param>io.github.grigoriev.im.invoice.IssueService</param>
                        <param>io.github.grigoriev.im.invoice.DocumentStore</param>
                        <param>io.github.grigoriev.im.invoice.DocumentKind</param>
                        <param>io.github.grigoriev.im.invoice.StoredDocument</param>
                        <param>io.github.grigoriev.im.invoice.DispatchService</param>
                        <param>io.github.grigoriev.im.invoice.DispatchChannel</param>
                        <param>io.github.grigoriev.im.invoice.PaymentService</param>
                        <param>io.github.grigoriev.im.invoice.ArchiveService</param>
                        <param>io.github.grigoriev.im.mail.MailTextService</param>
                        <param>io.github.grigoriev.im.mail.MailService</param>
                        <param>io.github.grigoriev.im.mail.MailProperties</param>
                        <param>io.github.grigoriev.im.mail.MailConfig</param>
                        <param>io.github.grigoriev.im.threshold.ThresholdService</param>
                        <param>io.github.grigoriev.im.threshold.Threshold</param>
                        <param>io.github.grigoriev.im.threshold.RevenueRow</param>
                        <param>io.github.grigoriev.im.backup.BackupService</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.grigoriev.im.einvoice.*Test</param>
                        <param>io.github.grigoriev.im.seller.*Test</param>
                        <param>io.github.grigoriev.im.numbering.*Test</param>
                        <param>io.github.grigoriev.im.validation.*Test</param>
                        <param>io.github.grigoriev.im.customer.*Test</param>
                        <param>io.github.grigoriev.im.country.*Test</param>
                        <param>io.github.grigoriev.im.audit.*Test</param>
                        <param>io.github.grigoriev.im.invoice.*Test</param>
                        <param>io.github.grigoriev.im.mail.*Test</param>
                        <param>io.github.grigoriev.im.threshold.*Test</param>
                        <param>io.github.grigoriev.im.backup.*Test</param>
                    </targetTests>
                    <!-- These tests run the full validators (KoSIT, veraPDF) and take a minute each. The mutated
                         classes have fast tests of their own, so PIT leaves the slow ones out. -->
                    <excludedTestClasses>
                        <param>io.github.grigoriev.im.einvoice.EInvoiceServiceTest</param>
                        <param>io.github.grigoriev.im.einvoice.ValidatorsTest</param>
                        <param>io.github.grigoriev.im.einvoice.PdfVisualTest</param>
                        <param>io.github.grigoriev.im.einvoice.InvoicePdfRendererTest</param>
                        <param>io.github.grigoriev.im.einvoice.EInvoiceWriterTest</param>
                    </excludedTestClasses>
                    <threads>4</threads>
                    <!-- The surefire argLine holds a JaCoCo placeholder that PIT cannot resolve. -->
                    <parseSurefireArgLine>false</parseSurefireArgLine>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                    <mutationThreshold>80</mutationThreshold>
                    <coverageThreshold>100</coverageThreshold>
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
                <executions>
                    <execution>
                        <id>mutation-tests</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The KoSIT configuration for XRechnung, checked against its SHA-256. -->
            <plugin>
                <groupId>io.github.download-maven-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>${download-plugin.version}</version>
                <executions>
                    <execution>
                        <id>xrechnung-configuration</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/${xrechnung-config.version}/${xrechnung-config.file}</uri>
                            <sha256>${xrechnung-config.sha256}</sha256>
                            <unpack>true</unpack>
                            <outputDirectory>${project.build.directory}/kosit-xrechnung</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
